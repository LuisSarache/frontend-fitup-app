{
  "expo": {
    "name": "FitUp",
    "slug": "fitup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/fitup-logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/fitup-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0F1E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitup.app"
    },
    "android": {
    "googleServicesFile": "./google-services.json",
    "adaptiveIcon": {
      "foregroundImage": "./assets/fitup-logo.png",
      "backgroundColor": "#0A0F1E"
      },
      "package": "com.fitup.app",
      "softwareKeyboardLayoutMode": "resize",
      "navigationBar": {
        "backgroundColor": "#0A0F1E"
      }
    },
    "web": {
      "favicon": "./assets/fitup-logo.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "8a720819-eb47-467d-9661-fa2ac35c7fa1"
      }
    }
  }
}
