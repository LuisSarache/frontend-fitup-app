{
  "expo": {
    "name": "FitUp",
    "slug": "fitup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/fitup-logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/fitup-logo.png",
      "resizeMode": "cover",
      "backgroundColor": "#0A0F1E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitup.app"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/fitup-logo.png",
        "backgroundColor": "#0A0F1E"
      },
      "package": "com.fitup.app",
      "softwareKeyboardLayoutMode": "resize",
      "navigationBar": {
        "backgroundColor": "#0A0F1E"
      }
    },
    "web": {
      "favicon": "./assets/fitup-logo.png",
      "bundler": "metro"
    },
    "extra": {
      "EXPO_PUBLIC_USE_MOCK": "true",
      "EXPO_PUBLIC_API_URL": "https://backend-fitup.onrender.com",
      "eas": {
        "projectId": "ff7fda5a-79c7-49db-be39-ae18e608eb7f"
      }
    }
  }
}
